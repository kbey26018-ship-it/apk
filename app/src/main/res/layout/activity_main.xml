<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gece_mavisi_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_sonsuz_yol" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Sonsuz Yol Arkadaşı"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchHybridMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PC / Yerel"
            android:textColor="@color/sonsuz_altin" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtStorageStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gece_mavisi_card"
        android:padding="10dp"
        android:text="SD Kart Model Durumu: Taranıyor..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@color/gece_mavisi_card"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtChatHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="Selam Halil, yanındayım. Bugün ne yapıyoruz?
"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtPrompt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@color/gece_mavisi_card"
            android:hint="Bana bir şey söyle..."
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/sonsuz_altin"
            android:text="Ses"
            android:textColor="@color/gece_mavisi_bg" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/gece_mavisi_accent"
            android:text="Gönder"
            android:textColor="@color/gece_mavisi_bg" />
    </LinearLayout>
</LinearLayout>
